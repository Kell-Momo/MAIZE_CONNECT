# ─── App ────────────────────────────────────────────────
APP_NAME=MaizeConnect API
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=maizeconnect
POSTGRES_USER=maize_user
POSTGRES_PASSWORD=your_strong_password_here

# ─── MongoDB ────────────────────────────────────────────
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB=maizeconnect_media

# ─── Firebase ────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# ─── AWS S3 ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-1
S3_BUCKET_NAME=maizeconnect-images

# ─── OpenWeatherMap ──────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key

# ─── Google Maps ─────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_maps_key

# ─── Moneero ────────────────────────────────────────────
MONEERO_API_KEY=your_moneero_key
MONEERO_BASE_URL=https://api.moneero.com/v1

# ─── FCM ────────────────────────────────────────────────
FCM_SERVER_KEY=your_fcm_server_key
